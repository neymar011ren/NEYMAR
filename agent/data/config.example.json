{
  "api_base_url": "https://api.openai.com/v1",
  "api_key": "",
  "model": "gpt-4o-mini",
  "protocol": "chat_completions",
  "temperature": 0.7,
  "max_tokens": 4096,
  "system_prompt": "你是一个本地可配置的 AI Agent。你可以调用工具完成任务，回答要简洁、可执行。",
  "enable_tools": true,
  "request_timeout_seconds": 120,
  "enable_memory": true,
  "memory_user_id": "default",
  "memory_embed_base_url": "https://api.openai.com/v1",
  "memory_embed_api_key": "",
  "memory_embed_model": "text-embedding-3-small",
  "memory_llm_model": "",
  "memory_top_k": 5,
  "memory_embed_dims": 1536
}
